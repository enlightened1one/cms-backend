{
	"name": "ccms-backend",
	"version": "1.0.0",
	"description": "Customer Complaint Management System — Multi-Tenant SaaS Backend",
	"author": "CCMS Engineering",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=18",
		"pnpm": ">=9"
	},
	"scripts": {
		"preinstall": "node -e \"if (process.env.npm_config_user_agent && !process.env.npm_config_user_agent.startsWith('pnpm')) { console.error('\\nUse pnpm to install dependencies\\n'); process.exit(1); }\"",
		"build": "prisma generate && nest build",
		"format": "prettier --write \"src/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"postinstall": "prisma generate",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"prisma:generate": "prisma generate",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"prisma:seed": "ts-node prisma/seed.ts"
	},
	"dependencies": {
		"@nestjs/common": "^11.2.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.2.1",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.2.1",
		"@nestjs/swagger": "^11.4.7",
		"@prisma/client": "^5.8.0",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"joi": "^17.11.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"swagger-ui-express": "^5.0.0"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.1",
		"@types/express": "^4.17.21",
		"@types/jest": "^29.5.11",
		"@types/node": "^20.11.0",
		"@types/passport-jwt": "^4.0.1",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.1.3",
		"jest": "^29.7.0",
		"prettier": "^3.2.4",
		"prisma": "^5.22.0",
		"source-map-support": "^0.5.21",
		"ts-jest": "^29.1.2",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.3.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	},
	"Transform": "AWS::Serverless-2016-10-31"
}